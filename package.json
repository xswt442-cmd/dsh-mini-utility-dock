{
  "name": "dsh-mini-utility-dock",
  "version": "0.3.0",
  "description": "The DSH plugin family's shared assets: source fragments (the Mini Utility Dock bootstrap for client halves, the loopback predicates and host request guard for host halves), the embedding CLI, and the family diagnostics — cross-repo drift check and bilingual docs structure check.",
  "type": "module",
  "bin": {
    "dsh-mini-utility-dock": "bin/dsh-mini-utility-dock.js",
    "dsh-plugin-parity": "bin/dsh-plugin-parity.js",
    "dsh-plugin-docs": "bin/dsh-plugin-docs.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "CHANGELOG.en.md"
  ],
  "scripts": {
    "dock:embed": "node bin/dsh-mini-utility-dock.js",
    "docs:check": "node bin/dsh-plugin-docs.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xswt442-cmd/dsh-mini-utility-dock.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "utility-dock"
  ],
  "license": "MIT"
}
